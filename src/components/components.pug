include ./intro/intro
include ./story/story
include ./timeline/timeline
include ./carousel/carousel
include ./polaroid/polaroid
include ./random-memory/random-memory
include ./quiz/quiz
include ./story-game/story-game
include ./mood/mood
include ./message/message
include ./final/final
include ./closing/closing
include ./memory-modal/memory-modal
include ./booking/booking
include ./effects/effects

mixin components(data)
  +effects
  +intro
  main.site#site(hidden, aria-hidden="true")
    +story
    p.whisper(data-reveal)
    +timeline
    p.whisper(data-reveal)
    +carousel
    +polaroid
    +random-memory
    +quiz
    +story-game-teaser
    +mood
    p.whisper.whisper_quiet(data-reveal)
    +message
    +final
    +closing
  +memory-modal
  +booking-modal
  +story-game-overlay
  audio.ambient(data-ambient-audio, loop, preload="none", aria-hidden="true")
