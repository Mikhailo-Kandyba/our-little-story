mixin random-memory
  section.section.random#random(aria-labelledby="random-title")
    p.section__eyebrow(data-reveal)
    h2#random-title.section__title(data-reveal, data-random-heading) Випадковий спогад ✨
    button.btn.btn_primary.random__btn(type="button", data-random-btn, data-magnetic, data-reveal) Що випаде цього разу?
    .random__stage(data-random-stage, aria-live="polite")
