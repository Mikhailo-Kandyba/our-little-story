mixin video-moments
  section.section.carousel-section.video-moments-section#video-moments(aria-labelledby="video-moments-title")
    p.section__eyebrow(data-reveal, data-video-moments-eyebrow)
    h2#video-moments-title.section__title(data-reveal)
    p.section__lead(data-reveal, data-video-moments-lead)
    .carousel.carousel_video(data-video-carousel, data-reveal)
