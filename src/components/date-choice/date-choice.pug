mixin date-choice
  section.section.date-choice-section#date-choice(
    data-date-choice,
    aria-labelledby="date-choice-title"
  )
    p.section__eyebrow(data-reveal, data-date-choice-eyebrow)
    h2#date-choice-title.section__title(data-reveal, data-date-choice-heading)
    p.section__lead(data-reveal, data-date-choice-lead)
    .date-choice(data-date-choice-root, data-reveal)
