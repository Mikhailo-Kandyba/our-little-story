{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "our-little-story",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-19",
  // Secrets via Dashboard / `wrangler secret put`: TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
  //
  // CRITICAL: run_worker_first must be true so POST /api/telegram always hits the
  // Worker. With assets-first (default), missing paths can 404 from the Assets
  // layer without invoking worker/index.js — which is the production failure mode.
  "assets": {
    "directory": "./dist/land-story",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
